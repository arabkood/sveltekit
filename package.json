{
	"name": "sveltekit",
	"private": true,
	"version": "0.0.2",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"dev": "vite dev",
		"dev-docker": "vite dev --host 0.0.0.0",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:pull": "./drizzle-pull-and-fix.sh",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.2",
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/adapter-node": "^5.5.2",
		"@sveltejs/enhanced-img": "^0.8.5",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/adm-zip": "^0.5.7",
		"@types/js-yaml": "^4.0.9",
		"@types/pg": "^8.16.0",
		"drizzle-kit": "^0.31.8",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"fancy-ansi": "^0.1.3",
		"globals": "^16.5.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1",
		"zod": "^4.3.6"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.982.0",
		"@polar-sh/sveltekit": "^0.4.11",
		"@popperjs/core": "^2.11.8",
		"adm-zip": "^0.5.16",
		"drizzle-orm": "^0.44.7",
		"highlight.js": "^11.11.1",
		"howler": "^2.2.4",
		"isomorphic-dompurify": "^2.35.0",
		"js-yaml": "^4.1.1",
		"marked": "^16.4.2",
		"marked-alert": "^2.1.2",
		"mime-types": "^3.0.2",
		"monaco-editor": "^0.53.0",
		"pg": "^8.18.0",
		"postgres": "^3.4.8",
		"posthog-js": "^1.339.1",
		"randexp": "^0.5.3",
		"svelte": "^5.49.1"
	},
	"packageManager": "pnpm@10.17.1"
}
