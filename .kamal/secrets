# Pulled from Bitwarden at deploy time. No raw credentials here — safe for git.
#
# Unlock your vault ONCE in the shell you run `kamal deploy` from:
#   export BW_SESSION=$(bw unlock --raw)
#   bw sync            # if you just added/changed items
#

if ! bw unlock --check >/dev/null 2>&1; then
  echo "ERROR: Bitwarden vault is locked. Run: export BW_SESSION=\$(bw unlock --raw)" >&2
  exit 1
fi

# --- image pull ---
KAMAL_REGISTRY_PASSWORD=$(bw get password KAMAL_REGISTRY_PASSWORD)

# --- component secrets (fetched first; the URLs below are built from them) ---
POSTGRES_USER=$(bw get password POSTGRES_USER)
POSTGRES_PASSWORD=$(bw get password POSTGRES_PASSWORD)
POSTGRES_DB=$(bw get password POSTGRES_DB)
VALKEY_PASSWORD=$(bw get password VALKEY_PASSWORD)

# --- connection URLs: CONSTRUCTED, not stored.
#     passwords must be URL-safe (e.g. `openssl rand -hex 32`)
#     a raw'@' ':' '/' in a password would corrupt these URLs.
#
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@akood-pg:5432/${POSTGRES_DB}"
VALKEY_URL="redis://:${VALKEY_PASSWORD}@akood-valkey:6379"

# --- app ---
WEBHOOK_SECRET=$(bw get password WEBHOOK_SECRET)
S3_ACCESS_KEY_ID=$(bw get password S3_ACCESS_KEY_ID)
S3_SECRET_ACCESS_KEY=$(bw get password S3_SECRET_ACCESS_KEY)
NATS_USER=$(bw get password NATS_USER)
NATS_PASSWORD=$(bw get password NATS_PASSWORD)
STRIPE_SECRET_KEY=$(bw get password STRIPE_SECRET_KEY)
STRIPE_WEBHOOK_SECRET=$(bw get password STRIPE_WEBHOOK_SECRET)
SMTP_USER=$(bw get password SMTP_USER)
SMTP_PASS=$(bw get password SMTP_PASS)
